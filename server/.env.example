# Database Configuration
DATABASE_URL="mysql://username:password@localhost:3306/cbmedic"

# JWT Authentication
JWT_SECRET="generate-a-long-random-string-here"

# Server Port
PORT=4000

# Other configs
NODE_ENV="production"

# CORS: orígenes permitidos, separados por coma (si se omite, se usan los defaults de producción/desarrollo)
CORS_ORIGINS="https://cbmedic.duckdns.org,http://localhost:5173,http://localhost:4173"

# Contraseña maestra para operaciones destructivas (anulaciones, eliminaciones)
ADMIN_MASTER_PASSWORD="define-una-clave-fuerte"

# Token de la API externa de consultas RENIEC/SUNAT (también configurable desde el panel)
RENIEC_API_TOKEN="coloca_tu_token"
